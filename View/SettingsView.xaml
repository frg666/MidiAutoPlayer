<UserControl x:Class="MidiAutoPlayer.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MidiAutoPlayer"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="一键自动调整" FontSize="14" Foreground="#8E8E93" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Border Background="Transparent" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="扫描所有MIDI文件，自动找到最佳音调并保存。" FontSize="14" Foreground="#8E8E93" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <ui:Button x:Name="Button_AutoAdjustAll"
                               Content="开始调整"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               MinWidth="140"
                               Height="40"
                               FontSize="15"
                               Click="Button_AutoAdjustAll_Click" />
                    <TextBlock x:Name="TextBlock_Progress" Margin="0,12,0,0" FontSize="14" Foreground="#8E8E93" />
                </StackPanel>
            </Border>

            <TextBlock Text="批量删除" FontSize="14" Foreground="#8E8E93" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Background="Transparent" CornerRadius="12" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="删除命中率低于" VerticalAlignment="Center" FontSize="14" />
                        <ui:NumberBox x:Name="TextBox_DeleteThreshold"
                                      Width="70"
                                      Minimum="0"
                                      Maximum="100"
                                      SmallChange="1"
                                      SpinButtonPlacementMode="Inline"
                                      ClearButtonEnabled="False"
                                      Background="Transparent"
                                      Value="90"
                                      FontSize="14"
                                      Margin="8,0" />
                        <TextBlock Text="%的文件" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                    <ui:Button x:Name="Button_DeleteBelowThreshold"
                               Content="删除"
                               Appearance="Danger"
                               HorizontalAlignment="Left"
                               MinWidth="140"
                               Height="40"
                               FontSize="15"
                               Click="Button_DeleteBelowThreshold_Click" />
                </StackPanel>
            </Border>

            <TextBlock Text="窗口透明度" FontSize="14" Foreground="#8E8E93" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Background="Transparent" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="拖动滑块调整窗口整体透明度。" FontSize="14" Foreground="#8E8E93" TextWrapping="Wrap" Margin="0,0,0,15" />
                    <Slider x:Name="Slider_Opacity"
                            Minimum="0.4"
                            Maximum="1.0"
                            Value="{Binding WindowOpacity, Mode=TwoWay}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1" />
                    <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="#8E8E93">
                        <Run Text="{Binding WindowOpacity, StringFormat=P0, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TextBlock_FileCount" Foreground="#8E8E93" FontSize="13" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
